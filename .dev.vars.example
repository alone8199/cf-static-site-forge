# 复制为 .dev.vars 后填写。该文件已在 .gitignore 中，切勿提交。
# 非机密配置请改 config/app.config.ts，不要放在这里。

# ---- 必需 ----
CAPTCHA_SECRET=replace-with-64-hex-chars
IP_HASH_SECRET=replace-with-64-hex-chars

# ---- SMTP（config/app.config.ts 中 mail.mode = "smtp" 时需要）----
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- 可选 ----
# 一次性管理员初始化令牌（至少 32 字符，用后删除，见 README）
BOOTSTRAP_TOKEN=
# Turnstile（config 中 captcha.provider = "turnstile" 时需要）
TURNSTILE_SECRET=

# ---- 超级用户（本地也可在 wrangler.toml 的 [vars] 中设置）----
# ADMIN_EMAILS=admin@example.com
# ADMIN_USER_IDS=
